DATABASE_URL=postgresql://user:heslo@ep-xxx.eu-central-1.aws.neon.tech/lovceny?sslmode=require
# E-maily: log (výchozí, jen do logu) | brevo (transakční API, free tier 300/den)
EMAIL_BACKEND=log
BREVO_API_KEY=
EMAIL_FROM=upozorneni@lovceny.cz
EMAIL_FROM_NAME=Lovceny
# Základ absolutních odkazů v e-mailech (potvrzení, odhlášení, logo)
PUBLIC_URL=https://lovceny.onrender.com
ALZA_FEED_URL=
DATART_FEED_URL=
ALZA_AFFILIATE_ID=
DATART_AFFILIATE_ID=
# eHUB (Smarty / iStyle / Sencor / XM.cz / EVOLVEO). Bez EHUB_AID → výchozí publisher ID 667205fc. EHUB_AID= (prázdné) vypne.
# EHUB_AID=667205fc
# LOVCENY_AFFILIATE=1
# ISTYLE_FEED_URL=   # volitelné; kód má veřejný default Heureka feed
# SENCOR_FEED_URL=
# XM_FEED_URL=
# EVOLVEO_FEED_URL=
# Dognet (Electronic-star, 4Home, Electrolux, Dyson). Bez DOGNET_CHID → výchozí kanál 9CFqgvpQ. DOGNET_CHID= (prázdné) vypne obalení.
# DOGNET_CHID=9CFqgvpQ
# ELECTRONICSTAR_FEED_URL=   # volitelné; kód má veřejný Heureka feed (záloha Mergado)
# FOURHOME_FEED_URL=         # volitelné; výchozí je Google Shopping XML 4Home (jen katalog, ne reklama)
# ELECTROLUX_FEED_URL=
# DYSON_FEED_URL=            # volitelné; výchozí je veřejná TradeDoubler URL z Dognetu
# AI hledání (Google Gemini, jen free tier – projekt bez billingu). Prázdné = hledání bez AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CAP=900
GEMINI_RPM_CAP=10
GEMINI_TIMEOUT_S=4
# Admin (/admin – statistiky, zprávy z formuláře). HTTP Basic: jméno libovolné, heslo = token. Min. 16 znaků.
ADMIN_TOKEN=
# Cache zmenšených obrázků (dočasný disk na Renderu stačí)
IMG_CACHE_DIR=/tmp/lovceny-img
IMG_CACHE_MAX_MB=150
