# Místní vývoj bez proměnné použije sqlite:///./lovceny.db
# DATABASE_URL=sqlite:///./lovceny.db
# Jednorázový přenos z Neonu čte Postgres URL jen ve workflow „Přenos z Neonu“.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lovceny-data
# E-maily: log (výchozí, jen do logu) | brevo (transakční API, free tier 300/den)
EMAIL_BACKEND=log
BREVO_API_KEY=
EMAIL_FROM=upozorneni@lovceny.cz
EMAIL_FROM_NAME=Lovceny
# Základ absolutních odkazů v e-mailech (potvrzení, odhlášení, logo)
PUBLIC_URL=https://lovceny.cz
ALZA_FEED_URL=
DATART_FEED_URL=
ALZA_AFFILIATE_ID=
DATART_AFFILIATE_ID=
# eHUB (Smarty / iStyle / Sencor / XM.cz / EVOLVEO / Počítače24 / JBL). Bez EHUB_AID → výchozí publisher ID 667205fc. EHUB_AID= (prázdné) vypne.
# EHUB_AID=667205fc
# LOVCENY_AFFILIATE=1
# Soukromé feedy. FEED_URLS je JSON {"ISTYLE_FEED_URL":"https://…", …}.
# Vlastní proměnná níže má přednost. Prázdné JSON i rozbitý JSON feed přeskočí a fetch nespadne.
# Hodnoty nepatří do gitu. Sestaví je scripts/build_feed_urls_json.py.
FEED_URLS=
ISTYLE_FEED_URL=
SENCOR_FEED_URL=
XM_FEED_URL=
EVOLVEO_FEED_URL=
TESLA_FEED_URL=
XUPE_FEED_URL=
TERA_FEED_URL=
AMAZESTORE_FEED_URL=
MISURA_FEED_URL=
DYSON_FEED_URL=
ALLEGRO_FEED_URL=
BSCOM_FEED_URL=
DRONPRO_FEED_URL=
IPHONEMARKET_FEED_URL=
# Dognet (Electronic-star, 4Home, Electrolux, Dyson, Allegro). Bez DOGNET_CHID → výchozí kanál 9CFqgvpQ. DOGNET_CHID= (prázdné) vypne obalení.
# DOGNET_CHID=9CFqgvpQ
# ELECTRONICSTAR_FEED_URL=   # volitelné; kód má veřejný Heureka feed (záloha Mergado)
# FOURHOME_FEED_URL=         # volitelné; výchozí je Google Shopping XML 4Home (jen katalog, ne reklama)
# ELECTROLUX_FEED_URL=
# DYSON_FEED_URL a ALLEGRO_FEED_URL jsou výše. Bez nich se Dyson a Allegro přeskočí.
# POCITACE24_FEED_URL=   # volitelné; kód má veřejný default https://www.pocitace24.cz/universal.xml
# JBL_FEED_URL=          # volitelné; kód má veřejný default https://www.jbl.cz/gmerchant-JBL-cz.xml
# AI hledání (Google Gemini, jen free tier – projekt bez billingu). Prázdné = hledání bez AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_DAILY_CAP=900
GEMINI_RPM_CAP=10
GEMINI_TIMEOUT_S=4
# Admin (/admin – statistiky, zprávy z formuláře). HTTP Basic: jméno libovolné, heslo = token. Min. 16 znaků.
ADMIN_TOKEN=
# Cache zmenšených obrázků (lokální adresář, výchozí /tmp)
IMG_CACHE_DIR=/tmp/lovceny-img
IMG_CACHE_MAX_MB=150
